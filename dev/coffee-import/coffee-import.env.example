# Copy to /etc/coffeepeek/coffee-import.env, fill private service addresses and a random 32+ character token.
# Set the SAME token as CoffeeImportAuthOptions__Token in both Shops and Media.
COFFEE_IMPORT_SHOPS_URL=http://127.0.0.1:5243
COFFEE_IMPORT_MEDIA_URL=http://127.0.0.1:5025
COFFEE_IMPORT_TOKEN=
