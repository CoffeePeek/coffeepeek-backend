# Public API domain (used by Caddy for HTTPS)
DOMAIN=api.coffeepeek.by
# Public MinIO domain for photo URLs in API responses (Caddy reverse-proxies to MinIO)
MEDIA_DOMAIN=media.coffeepeek.by
MEDIA_PUBLIC_URL=https://media.coffeepeek.by
# imgproxy resized variants (thumbnail/card/detail/fullscreen), served by Caddy under MEDIA_DOMAIN/img.
# Leave empty and the API returns the plain MinIO URL for every variant.
IMAGE_PROXY_URL=https://media.coffeepeek.by/img
ACME_EMAIL=you@example.com

# Gateway loopback only (health checks / debug). Public API is Caddy :443.
GATEWAY_PORT=8080
# Dedicated proxy /24: Caddy .2, Gateway .3, dynamic addresses .128-.254.
# Choose a different private prefix if this subnet overlaps an existing Docker/VPN network.
PROXY_NETWORK_PREFIX=172.30.42

# Daily coffee import is disabled until a reviewed map and a shared token are configured.
# setup-coffee-import.sh generates/persists the token and the job's private env file.
COFFEE_IMPORT_TOKEN=
COFFEE_IMPORT_MAPPING_FILE=./coffee-import/disabled-mapping.json
COFFEE_IMPORT_SHOPS_PORT=5243
COFFEE_IMPORT_MEDIA_PORT=5025

# Docker images — use Docker Hub from CI, or "coffeepeek" for local builds
DOCKER_IMAGE_PREFIX=docker.io/YOUR_DOCKERHUB_USERNAME
IMAGE_TAG=dev

# Public addresses: enable per service after migrations and rollout verification.
# Existing entities need reviewed, page-by-page admin backfill (docs/api/public-addresses.md).
SHOPS_PUBLIC_ADDRESSES_ENABLED=false
ACCOUNT_PUBLIC_ADDRESSES_ENABLED=false

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-postgres-password

# Redis
REDIS_PASSWORD=change-me-strong-redis-password

# RabbitMQ
RABBITMQ_USER=coffeepeek
RABBITMQ_PASSWORD=change-me-strong-rabbitmq-password
# Use "/" for a fresh VPS; match an existing broker's vhost when reusing one.
RABBITMQ_VHOST=/

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=coffeepeek
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
MINIO_CHECKIN_READ_USER=coffeepeek-checkin-reader
# Generated by ensure-secrets.sh when empty; use a dedicated reader identity.
MINIO_CHECKIN_READ_PASSWORD=

# JWT (must match across gateway + account service)
JWT_SECRET_KEY=change-me-at-least-32-characters-long-secret
# HMAC pepper for account-deletion confirmation tokens. Must be at least 32 characters.
# Leave empty to let deploy scripts generate a dedicated value, or to fall back to JWT_SECRET_KEY.
ACCOUNT_DELETION_TOKEN_PEPPER=
APP_RELEASE_AUTOMATION_TOKEN=
# Gateway -> service trust secret (X-Gateway-Auth), >= 32 chars. Leave empty to let deploy scripts generate it.
GATEWAY_AUTH_SECRET=
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# Google Sign-In — must match frontend VITE_GOOGLE_CLIENT_ID (full client id, including .apps.googleusercontent.com).
# ID-token login only needs ClientId; ClientSecret is optional.
GOOGLE_CLIENT_ID=770099870632-5eeebr3eqdrma4reson9mv02j4lro583.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Apple Sign-In: native bundle ID; browser flow additionally needs all five web settings.
# The .p8 private key may use literal \n escapes; keep the real key outside Git.
APPLE_CLIENT_ID=com.coffeepeek
APPLE_WEB_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PEM=
APPLE_REDIRECT_URI=

# External services
RESEND_API_TOKEN=
WEB_CLIENT_URL=https://coffeepeek.by
SENTRY_DSN_GATEWAY=
SENTRY_DSN_ACCOUNT=
SENTRY_DSN_SHOPS=
SENTRY_DSN_MODERATION=
SENTRY_DSN_MEDIA=
YANDEX_GEOCODER_API_KEY=
GOOGLE_PLACES_API_KEY=
# Telegram bot must be allowed to message this private chat or group.
TELEGRAM_MODERATION_BOT_TOKEN=
TELEGRAM_MODERATION_CHAT_ID=
# Optional trusted HTTPS relay; empty uses the Telegram Bot API directly.
TELEGRAM_MODERATION_RELAY_URL=
# OpenAI vision parser (ShopsService menu photos).
# OPENAI_BASE_URL can point at an OpenAI-compatible gateway.
# For the shared Cloudflare Worker, use https://coffeepeek-proxy.goloologo.workers.dev/v1 (not /v1beta).
# OPENAI_PROXY_URL is an HTTP/SOCKS proxy when the server IP is in an unsupported region.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROXY_URL=
OPENAI_TIMEOUT_SECONDS=90

# Private variants: populated by ensure-secrets.sh; keep generation off until live acceptance passes.
MINIO_CHECKIN_VARIANT_USER=coffeepeek-checkin-variant-writer
MINIO_CHECKIN_VARIANT_PASSWORD=
CHECKIN_RENDERER_KEY=
CHECKIN_RENDERER_SALT=
CHECKIN_VARIANTS_ENABLED=false
CHECKIN_VARIANTS_CLEANUP_ENABLED=false
CHECKIN_VARIANTS_CLEANUP_DRY_RUN=true

# P3: deploy migrations and verify protected reads before advertising variants.
MINIO_CHECKIN_VARIANT_READ_USER=coffeepeek-checkin-variant-reader
MINIO_CHECKIN_VARIANT_READ_PASSWORD=
CHECKIN_VARIANTS_READ_ENABLED=false
CHECKIN_VARIANTS_SERVE_ENABLED=false
CHECKIN_VARIANTS_ADVERTISE_ENABLED=false
# Controlled pilot: enable canary-only and supply 1..100 distinct viewer UUIDs as CSV before advertisement.
# Canary-only with an empty/invalid list refuses startup, even while advertisement is disabled.
# When canary-only is false the existing global advertisement behavior is preserved.
CHECKIN_VARIANTS_CANARY_ONLY=false
CHECKIN_VARIANTS_CANARY_USER_IDS=
# Enable 20s policy facts / <=20s private client freshness only after cache acceptance gates.
CHECKIN_VARIANTS_CACHE_ENABLED=false
