{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information",
      "Yarp.ReverseProxy.Health": "Error"
    }
  },
  "AllowedHosts": "*",
  "Sentry": {
    "Dsn": "",
    "SendDefaultPii": false,
    "EnableLogs": true,
    "EnableMetrics": true
  },
  "JWTOptions": {
    "SecretKey": "",
    "AccessTokenLifetimeMinutes": "",
    "RefreshTokenLifetimeDays": "",
    "Audience": "CoffeePeek.API",
    "Issuer": "CoffeePeek.WEB"
  },
  "RedisOptions": {
    "Host": "localhost",
    "Port": 6379,
    "Password": ""
